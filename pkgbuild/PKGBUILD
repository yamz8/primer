pkgname=primer
pkgver=0.1.0
pkgrel=1
pkgdesc='Design and check PCR primers'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/primer "$pkgdir/usr/bin/primer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/primer.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/primer.svg"
  install -Dm644 "$startdir/primer.desktop" "$pkgdir/usr/share/applications/primer.desktop"
}
